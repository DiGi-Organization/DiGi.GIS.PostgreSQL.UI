<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>

		<OutputPath>..\bin\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>

		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>

		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<ApplicationIcon>Resources\DiGi.GIS.ico</ApplicationIcon>

		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Server GC (DiGi-Organization/DiGi.GIS.PostgreSQL#170): the background tasks convert in parallel and allocate
		     heavily per item, and under the workstation GC the workers queue on one heap - the open building import
		     converted 1.35x faster on 16 workers than on one, 7.4x under server GC (wiki Benchmark.md). Since .NET 9 the
		     server GC adapts its heap count to the load (DATAS), so an idle tray does not hold one heap per core. -->
		<ServerGarbageCollection>true</ServerGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\DiGi.GIS.PostgreSQL.UI\DiGi.GIS.PostgreSQL.UI.csproj" />
	</ItemGroup>

	<!-- WPF host: Application and MessageBox mean the WPF types; a file using Windows Forms imports it itself -->
	<ItemGroup>
		<Using Remove="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<Target Name="CopyFiles" AfterTargets="Build">
		<ItemGroup>
			<_Files Include="$(ProjectDir)..\files\**\*.*" />
		</ItemGroup>
		<Message Text="Copying all files from directory..." Importance="high" />
		<Copy SourceFiles="@(_Files)" DestinationFiles="@(_Files->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyUserFiles" AfterTargets="CopyFiles">
		<ItemGroup>
			<_UserFiles Include="$(ProjectDir)..\user files\**\*.*" />
		</ItemGroup>
		<Message Text="Copying all user files from directory..." Importance="high" />
		<Copy SourceFiles="@(_UserFiles)" DestinationFiles="@(_UserFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="ForceCopyAspNetCoreDlls" AfterTargets="ResolveFrameworkReferences">
		<ItemGroup>
			<ResolvedCompileFileDefinitions Update="@(ResolvedCompileFileDefinitions)">
				<CopyLocal>true</CopyLocal>
			</ResolvedCompileFileDefinitions>
		</ItemGroup>
	</Target>

	<!-- DiGi.PRG and DiGi.PRG.Geometry are compile-only <Reference> (HintPath) items of the .UI project, so they are
	     not runtime assets and do not flow across the ProjectReference into this host's deps.json. The PRG import task
	     loads them at runtime; declare them as direct host references so they reach the host deps.json (re-declare on the
	     host the dependencies that HintPath references drop). -->
	<ItemGroup>
		<Reference Include="DiGi.PRG">
			<HintPath>..\..\DiGi.PRG\bin\DiGi.PRG.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.PRG.Geometry">
			<HintPath>..\..\DiGi.PRG\bin\DiGi.PRG.Geometry.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>