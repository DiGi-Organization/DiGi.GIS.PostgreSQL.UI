<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.OpenBuildingImportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Import open building dataset" Height="840" Width="1100" MinHeight="820" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Dataset" VerticalAlignment="Center" />
                <TextBlock x:Name="TextBlock_Dataset" Grid.Column="1" VerticalAlignment="Center" Margin="5,0,5,0" FontWeight="Bold" />
            </Grid>

            <Label x:Name="Label_SourcePaths" Grid.Row="1" Content="Source files - every file the release came in; the SHA-256 is computed from them" Margin="5,5,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

            <controls:ListBoxControl x:Name="ListBoxControl_SourcePaths" Grid.Row="2" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,5,10,0">
                <Button x:Name="Button_AddFiles" Content="Add files..." Width="90" Height="23" Click="Button_AddFiles_Click" />
                <Button x:Name="Button_AddFolder" Content="Add folder..." Width="90" Height="23" Margin="8,0,0,0" Click="Button_AddFolder_Click" ToolTip="Adds every file of this dataset's type below the folder, sub-folders included" />
                <Button x:Name="Button_RemoveFiles" Content="Remove" Width="80" Height="23" Margin="8,0,0,0" Click="Button_RemoveFiles_Click" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5,8,5,0">
                <RadioButton x:Name="RadioButton_CountyParts" Content="Scope: county parts" Checked="Scope_Changed" Margin="5,0,15,0" VerticalAlignment="Center" />
                <RadioButton x:Name="RadioButton_BoundingBox" Content="Scope: bounding box (EPSG:2180)" Checked="Scope_Changed" Margin="5,0,5,0" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:TextBoxControl x:Name="TextBoxControl_Version" Grid.Column="0" HorizontalAlignment="Stretch" Text="Version - required, the register keys on it" Value="" />
                <controls:TextBoxControl x:Name="TextBoxControl_DownloadDate" Grid.Column="1" HorizontalAlignment="Stretch" Text="Download date - required, e.g. 2026-11-06" Value="" />
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:TextBoxControl x:Name="TextBoxControl_Licence" Grid.Column="0" HorizontalAlignment="Stretch" Text="Licence" Value="" />
                <controls:TextBoxControl x:Name="TextBoxControl_SourceUrl" Grid.Column="1" HorizontalAlignment="Stretch" Text="Source URL" Value="" />
            </Grid>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:TextBoxControl x:Name="TextBoxControl_SourceObservationDate" Grid.Column="0" HorizontalAlignment="Stretch" Text="Source observation date" Value="" />
                <controls:TextBoxControl x:Name="TextBoxControl_FileName" Grid.Column="1" HorizontalAlignment="Stretch" Text="File name recorded for the release" Value="" />
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:TextBoxControl x:Name="TextBoxControl_Quadkey" Grid.Column="0" HorizontalAlignment="Stretch" Text="Quadkey - Microsoft" ToolTip="Microsoft only: fill it for a file outside a quadkey=&lt;digits&gt; folder - a file inside one takes its quadkey from the path" Value="" />
                <controls:TextBoxControl x:Name="TextBoxControl_Sha256" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" Text="SHA-256 - computed from the source files" Value="" />
            </Grid>

            <Grid Grid.Row="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="CheckBox_SkipSourcesOutOfScope" Grid.Column="0" Content="Leave unread out-of-scope files" ToolTip="Leave unread the files that cannot reach the scope. A file is left out only when it states its own extent - a Microsoft quadkey tile, a GeoPackage R-tree, a GeoParquet bbox - and that extent reaches no county part of the scope. The rows stored are the same either way; the out-of-scope and rejection counts then cover only the files read, and the register row names the files left out. Clear it for an audit run that reads every file." Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                <controls:TextBoxControl x:Name="TextBoxControl_MaxDegreeOfParallelism" Grid.Column="1" HorizontalAlignment="Stretch" Text="Max degree of parallelism (0 = half)" ToolTip="Max degree of parallelism - 0 uses half the processors, 1 converts on one thread" Value="" />
            </Grid>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Margin="10,5,10,0">
            <Grid x:Name="Grid_CountyScope">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label x:Name="Label_Counties" Grid.Row="0" Content="County parts - one entry per piece; select what the run covers" ToolTip="County parts - a multi-part county is one entry per piece; select the pieces the run covers" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="1" SelectionMode="Extended" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>

            <StackPanel x:Name="StackPanel_BoundingBox" VerticalAlignment="Top" Visibility="Collapsed">
                <Label Content="Bounding box in EPSG:2180 - lower left and upper right corners" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:TextBoxControl x:Name="TextBoxControl_X1" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Text="x1 (easting)" Value="" />
                    <controls:TextBoxControl x:Name="TextBoxControl_Y1" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Text="y1 (northing)" Value="" />
                    <controls:TextBoxControl x:Name="TextBoxControl_X2" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Text="x2 (easting)" Value="" />
                    <controls:TextBoxControl x:Name="TextBoxControl_Y2" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Text="y2 (northing)" Value="" />
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,5,5,5">
            <Button x:Name="Button_ImportSettings" Content="Import settings..." Width="110" Height="23" Click="Button_ImportSettings_Click" ToolTip="Fills the window from a settings file written by Export settings. Nothing runs until OK" />
            <Button x:Name="Button_ExportSettings" Content="Export settings..." Width="110" Height="23" Margin="8,0,0,0" Click="Button_ExportSettings_Click" ToolTip="Writes what the window holds now - source files, scope, release metadata, parallelism - to a settings file. The SHA-256 is left out: it is computed at every run" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
