<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.PostgreSQLBuildingDataExternalComponentsUpdateOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Update external components area" Height="662" Width="560" MinHeight="360" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="60" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <Label x:Name="Label_Counties" Grid.Row="0" Content="Counties - a multi-part county is one entry per piece; select them all" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="1" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <controls:TextBoxControl x:Name="TextBoxControl_CommandTimeout" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Command timeout in seconds - 0 disables it" Value="" />

        <controls:TextBoxControl x:Name="TextBoxControl_BatchSize" Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Batch size - buildings read and written together" Value="" />

        <CheckBox x:Name="CheckBox_SkipCompleted" Grid.Row="4" Content="Skip buildings already done - resumes an interrupted run" Margin="10,0,10,0" VerticalAlignment="Center" />

        <CheckBox x:Name="CheckBox_PartyWalls" Grid.Row="5" Content="Party walls - measure the walls shared with neighbouring buildings (much slower)" Margin="10,0,10,0" VerticalAlignment="Center" />

        <controls:TextBoxControl x:Name="TextBoxControl_MaxDegreeOfParallelism" Grid.Row="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Parallel batches - 0 = half of the processors, 1 = one at a time" ToolTip="How many batches of a county are read and written at once. 0 uses half of the logical processors, 1 processes one batch at a time as before. The stored rows do not depend on it; memory grows with the number of batches times the batch size." Value="" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_ImportSettings" Content="Import settings..." Width="110" Height="23" Click="Button_ImportSettings_Click" ToolTip="Fills the window from a settings file written by Export settings. Nothing runs until OK" />
            <Button x:Name="Button_ExportSettings" Content="Export settings..." Width="110" Height="23" Margin="8,0,0,0" Click="Button_ExportSettings_Click" ToolTip="Writes what the window holds now - the counties, timeout, batch, skip, party walls, parallel batches - to a settings file" />
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
