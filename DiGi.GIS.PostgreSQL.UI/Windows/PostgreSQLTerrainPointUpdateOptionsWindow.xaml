<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.PostgreSQLTerrainPointUpdateOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Update TerrainPoints" Height="500" Width="520" MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <controls:TextBoxControl x:Name="TextBoxControl_GridSize" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Grid size - keep to values that nest, such as 100, 50 or 10" Value="" />

        <CheckBox x:Name="CheckBox_OverrideExisting" Grid.Row="1" Content="Override existing points" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <Label x:Name="Label_Counties" Grid.Row="2" Content="Counties - a multi-part county is one entry per piece; select them all" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="3" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Says whether the point densities beside the counties have been read yet: without it a county with no
             figure could be one never sampled or one whose density simply has not arrived. -->
        <Label x:Name="Label_Density" Grid.Row="4" Content="" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Shown only while the densities are being read (Coding - WPF Deferred Loading.md). -->
            <ProgressBar x:Name="ProgressBar_Density" Grid.Column="0" IsIndeterminate="True" Width="150" Height="14" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Reading terrain point densities" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
                <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
                <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
