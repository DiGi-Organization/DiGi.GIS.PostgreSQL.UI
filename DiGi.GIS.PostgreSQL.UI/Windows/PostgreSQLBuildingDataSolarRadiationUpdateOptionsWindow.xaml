<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.PostgreSQLBuildingDataSolarRadiationUpdateOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Update building data solar summary" Height="620" Width="560" MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
            <RowDefinition Height="26" />
            <RowDefinition Height="60" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <Label x:Name="Label_Counties" Grid.Row="0" Content="Counties - a multi-part county is one entry per piece; select them all" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="1" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <controls:TextBoxControl x:Name="TextBoxControl_Radius" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Radius in m - empty = latest of any radius" ToolTip="The radius whose stored results the summary is built from, exactly as stored. Empty takes the latest stored result of any radius, building by building; 0 is the isolated building." Value="" />

        <CheckBox x:Name="CheckBox_SkipCompleted" Grid.Row="3" Content="Skip rows that already carry a yearly total" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <UniformGrid Grid.Row="4" Rows="1" Columns="2">
            <controls:TextBoxControl x:Name="TextBoxControl_BatchSize" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Batch size (references)" Value="" />
            <controls:TextBoxControl x:Name="TextBoxControl_CommandTimeout" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Timeout in s (0 = none)" ToolTip="Command timeout in seconds applied to every statement; 0 disables it" Value="" />
        </UniformGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
