<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.YearBuiltPredictionsOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiGi.GIS.PostgreSQL.UI.Windows"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Predict year built" Height="550" Width="620" MinHeight="440" MinWidth="480" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <!-- The window can still be taller than a small screen's work area, so everything above the buttons
             scrolls and the buttons themselves stay pinned: a dialog whose OK can be pushed off the bottom of
             the work area is one whose only exit is the window's close box. MaxHeight on the window keeps it
             inside the work area, and the fixed row heights below are what the scroll is measured against. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="200" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <controls:TextBoxControl x:Name="TextBoxControl_ScratchDirectory" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Scratch directory - one folder per county, named after its identifier" Value="" />

                <controls:TextBoxControl x:Name="TextBoxControl_PythonPath" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Python interpreter - a path, or a name on PATH; empty tries python then python3" Value="" />

                <controls:TextBoxControl x:Name="TextBoxControl_MaxConcurrentRequests" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Max concurrent requests - image export; turn it down when the server starts refusing" Value="" />

                <!-- Said before the counties are chosen rather than only in the confirmation the task raises
                     afterwards: the run has one shape now, and that shape writes. -->
                <Label x:Name="Label_Writes" Grid.Row="3" Content="Every run writes to stored data - detections, year built data and predicted year built" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <CheckBox x:Name="CheckBox_CleanScratchDirectory" Grid.Row="4" Content="Clean scratch directory unless the county failed" Margin="10,0,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" />

                <Label x:Name="Label_Counties" Grid.Row="5" Content="Counties - a multi-part county is one entry per piece; select them all" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                <controls:ListBoxControl x:Name="ListBoxControl_Counties" Grid.Row="6" SelectionMode="Extended" Margin="10,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Says what the markers mean, and whether they have been read yet: without it a county with no
                     marker could be one never run or one whose coverage simply has not arrived. -->
                <Label x:Name="Label_Coverage" Grid.Row="7" Content="" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
