<Window x:Class="DiGi.GIS.PostgreSQL.UI.Windows.UserSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DiGi.UI.WPF.Controls;assembly=DiGi.UI.WPF"
        mc:Ignorable="d"
        Title="Sign in" Height="250" Width="460" MinHeight="230" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/DiGi.GIS.PostgreSQL.UI;component/Resources/DiGi.GIS.ico">
    <Grid Margin="5,5,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="28" />
            <RowDefinition Height="33" />
            <RowDefinition Height="*" />
            <RowDefinition Height="33" />
        </Grid.RowDefinitions>

        <controls:TextBoxControl x:Name="TextBoxControl_Email" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Text="Email - the account the results are written under" Value="" />

        <Label x:Name="Label_Password" Grid.Row="1" Content="Password - used once to sign in, never stored" Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <PasswordBox x:Name="PasswordBox_Password" Grid.Row="2" Height="23" Margin="10,5,10,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,5,5,5">
            <Button x:Name="Button_OK" Content="OK" Width="70" Height="23" Margin="5,0,5,0" IsDefault="True" Click="Button_OK_Click" />
            <Button x:Name="Button_Cancel" Content="Cancel" Width="70" Height="23" Margin="5,0,5,0" IsCancel="True" Click="Button_Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
